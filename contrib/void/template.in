# Template file for 'amorphis'
pkgname=amorphis
version=@VERSION@
revision=1
build_style=cargo
hostmakedepends="pkg-config"
makedepends="libxcb-devel libxkbcommon-devel pam-devel wayland-devel"
conf_files="/etc/pam.d/amorphis"
short_desc="Small fail-closed screen locker for Wayland and X11"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MIT"
homepage="https://github.com/dani-77/amorphis"
repository=d77
distfiles="https://github.com/dani-77/amorphis/archive/refs/tags/v${version}.tar.gz"
checksum=@CHECKSUM@

post_install() {
	vlicense LICENSE
	vinstall contrib/pam/amorphis.void 644 etc/pam.d amorphis
}
